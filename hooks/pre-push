#!/usr/bin/env bash
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

# The tree of each commit being pushed, not the working tree beside it.
pushed() {
  local tree index
  tree=$(mktemp -d) || return 1
  index=$(mktemp) || { rm -rf "$tree"; return 1; }
  GIT_INDEX_FILE="$index" git read-tree "$1" \
    && GIT_INDEX_FILE="$index" git checkout-index --all --prefix="$tree/" \
    && bash "$tree/scripts/rules.sh" < /dev/null
  local said=$?
  rm -rf "$tree" "$index"
  return $said
}

nothing=0000000000000000000000000000000000000000
status=0
while read -r _ mine _ theirs; do
  [ -n "${mine:-}" ] || continue
  [ "$mine" != "$nothing" ] || continue
  pushed "$mine" || status=1
  # A remote commit never fetched here cannot start a range; main can.
  if [ "${theirs:-$nothing}" != "$nothing" ] && git cat-file -e "$theirs^{commit}" 2> /dev/null; then
    range="$theirs..$mine"
  elif base=$(git merge-base "$mine" origin/main 2> /dev/null) && [ -n "$base" ]; then
    range="$base..$mine"
  else
    echo "!  origin/main is not here, so the subjects were not looked at"
    continue
  fi
  bash scripts/commits.sh "$range" || status=1
done

exit $status
