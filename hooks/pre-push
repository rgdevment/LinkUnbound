#!/usr/bin/env bash
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

# The tree of each commit being pushed, not the working tree beside it.
pushed() {
  local tree index
  tree=$(mktemp -d) || return 1
  index=$(mktemp) || { rm -rf "$tree"; return 1; }
  GIT_INDEX_FILE="$index" git read-tree "$1" \
    && GIT_INDEX_FILE="$index" git checkout-index --all --prefix="$tree/" \
    && bash "$tree/scripts/rules.sh" < /dev/null
  local said=$?
  rm -rf "$tree" "$index"
  return $said
}

# Measured against the branch the remote being pushed to calls its own, not a name taken for granted.
remote=${1:-origin}
# A push straight to a URL names no remote, and is measured against origin's.
git remote get-url "$remote" > /dev/null 2>&1 || remote=origin
main=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2> /dev/null || echo "$remote/main")

nothing=0000000000000000000000000000000000000000
status=0
while read -r ref mine where theirs; do
  [ -n "${mine:-}" ] || continue
  [ "$mine" != "$nothing" ] || continue
  # The name it takes on the remote, which is the one everybody sees.
  case ${where:-} in
    refs/heads/*) bash scripts/commits.sh --branch "${where#refs/heads/}" || status=1 ;;
  esac
  # A tag is the last moment to notice the version it names has nothing to tell whoever installs it.
  case ${ref:-} in
    refs/tags/v*)
      told=$(mktemp)
      git show "$mine^{commit}:app/src/news.json" > "$told" 2> /dev/null || rm -f "$told"
      NEWS="$told" bash scripts/news.sh "${ref#refs/tags/v}" || status=1
      rm -f "$told"
      ;;
  esac
  pushed "$mine" || status=1
  # A remote commit never fetched here cannot start a range; main can.
  if [ "${theirs:-$nothing}" != "$nothing" ] && git cat-file -e "$theirs^{commit}" 2> /dev/null; then
    range="$theirs..$mine"
  elif base=$(git merge-base "$mine" "$main" 2> /dev/null) && [ -n "$base" ]; then
    range="$base..$mine"
  else
    echo "!  $main is not here, so the subjects were not looked at"
    continue
  fi
  bash scripts/commits.sh "$range" || status=1
done

exit $status
