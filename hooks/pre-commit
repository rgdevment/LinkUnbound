#!/usr/bin/env bash
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0
status=0

# What is about to be committed, not what the working tree happens to hold beside it.
staged=$(mktemp -d) || {
  echo "x  no temporary directory could be made, so nothing was looked at"
  exit 1
}
trap 'rm -rf "$staged"' EXIT
git checkout-index --all --ignore-skip-worktree-bits --prefix="$staged/" || {
  echo "x  the staged tree could not be written out, so nothing was looked at"
  exit 1
}
biome="$PWD/app/node_modules/.bin/biome"

bash "$staged/scripts/rules.sh" < /dev/null || status=1

quietly() {
  local said
  said=$(eval "$1" 2>&1) || {
    printf '%s\n' "$said"
    printf 'x  %s\n' "$2"
    status=1
  }
}

if command -v cargo > /dev/null; then
  quietly 'cd "$staged" && cargo fmt --all --check' "cargo fmt --all would change files"
else
  echo "!  cargo is not here, so the formatting was not looked at"
fi

if [ -x "$biome" ]; then
  quietly 'cd "$staged/app" && "$biome" check src' \
    "biome would change files; it is the first thing CI runs on the window"
else
  echo "!  app/node_modules is not here, so biome did not look at the window"
fi

exit $status
