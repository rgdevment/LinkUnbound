import { Destination, Reach, Palette, Look, UpdateStrip, Hair, AddressHead, AskHead, RememberFoot, ReachMenu } from "parts.slint";
import { ListLook, CardsLook, CompactLook } from "looks.slint";

export { Palette, Look } from "parts.slint";
export { BearHead, BearPaws } from "bear.slint";

export component Picker inherits Window {
    in property <float> icon-side: 24;
    in property <string> host;
    in property <string> trail;
    in property <string> source-line;
    in property <string> remember-label;
    in property <string> remember-short;
    in property <string> private-label;
    in property <string> private-line;
    in property <string> ask;
    in property <string> ask-private;
    in property <string> motto;
    in property <string> add;
    in property <string> add-more;
    in property <[Destination]> rows;
    in property <[Reach]> reaches;
    in property <[Reach]> reaches-more;
    in property <[Reach]> all-reaches;
    in property <[string]> reach-labels;
    in property <string> reach-more-label;
    in property <string> reaches-line;
    in property <string> problem;
    in property <bool> alarming: true;
    in-out property <int> reach-index: 0;
    in-out property <bool> private-on: false;
    in-out property <bool> more-open: false;
    // The row the arrows rest on, opened by Enter; none until an arrow is pressed.
    in-out property <int> chosen-at: -1;
    // Shown from settings over a sample link: a choice puts it away and opens nothing.
    in-out property <bool> preview: false;

    in property <Look> look: Look.bear;
    in property <bool> on-mac: false;
    // Room around the sheet for the shadow it draws itself. Zero where the system draws one.
    in property <length> halo: 0px;

    // True while the chosen reach is one the row does not show, which is when the opener has to
    // say which one rather than «More»: otherwise the choice is made and nothing on screen says
    // what it was.
    out property <bool> more-holds: !root.in-the-row[root.reach-index];
    in property <[bool]> in-the-row;
    in-out property <bool> pinned-private: false;
    in-out property <bool> copied: false;

    // An update owed, in the words the resident composed: empty stage, no strip.
    in property <string> update-stage;
    in property <string> update-line;
    in property <string> update-detail;
    in property <string> update-button;
    in property <string> update-later;
    in property <string> copy-label;
    in property <int> update-far: 0;
    property <bool> update-shown: root.update-stage != "";
    property <bool> update-busy: root.update-stage == "starting" || root.update-stage == "getting" || root.update-stage == "installing";
    property <length> strip-room: root.update-shown ? 46px : 0px;
    callback update-asked();
    callback update-dismissed();

    callback open(int, bool);
    /// Returns whether the key was a destination. See `key-pressed`.
    callback typed(string, bool) -> bool;
    /// The reach the keys land on next, one step either way; the dead ones are stepped over.
    pure callback step-reach(int) -> int;
    callback dismissed();
    callback copy();
    callback add-browser();
    // Where the bear looks, from -1 to 1, and whether it wears the mask.
    callback mood(float, bool);

    title: "LinkUnbound";
    icon: @image-url("../../../app/src-tauri/icons/128x128.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: root.wanted-width;
    height: root.wanted-height;
    in property <string> family;
    default-font-family: root.family;
    forward-focus: keys;

    property <int> hovered-at: -1;
    property <int> aimed: root.hovered-at >= 0 ? root.hovered-at : root.chosen-at;
    property <float> count: root.rows.length;
    property <bool> cards: root.look == Look.bear || root.look == Look.tiles;
    property <float> aim:
        root.aimed < 0 ? 0
        : root.cards ? (Math.mod(root.aimed, 3) - 1) * 0.7
        : ((root.aimed + 0.5) / max(1, root.count) - 0.5) * 2;
    changed aim => { root.mood(root.aim, root.private-on); }
    changed private-on => { root.mood(root.aim, root.private-on); }

    property <string> line: root.problem != "" ? root.problem : (root.private-on ? root.private-line : root.source-line);
    property <brush> line-color: root.problem != "" ? (root.alarming ? Palette.wrong : Palette.caution) : (root.private-on ? Palette.secret : Palette.dim);
    out property <string> reach-said: root.all-reaches[root.reach-index].full;
    property <string> more-said: root.more-holds ? root.reach-labels[root.reach-index] : root.reach-more-label;

    // Nine rows at most on screen, the keys stop at 9, and the rest scroll under them.
    property <float> rows-shown: min(root.count, 9);
    property <length> list-room: max(1, root.rows-shown) * 45px + 11px;
    // A fifth reach appears when the click came from a known app, and its label carries that
    // app's name, which no fixed width can be drawn for: the track asks for the room it needs.
    property <length> track-need: ruler.preferred-width + 60px + root.reaches.length * 18px;
    property <length> list-width: min(max(380px, root.track-need), 560px);
    ruler := Text {
        text: root.reaches-line;
        font-size: 12.5px;
        visible: false;
    }

    // Three columns of cards; four rows on screen and the rest scroll.
    property <length> cards-room: min(4, max(1, Math.ceil(root.count / 3))) * 58px + 10px;

    property <float> icons-shown: max(1, root.count);
    property <length> compact-width: max(280px, root.icons-shown * 54px - 4px + 20px);
    property <length> compact-height: 12px + 28px + 6px + 72px + 6px + 20px + 6px + 26px + 10px;

    property <length> foot-room: 74px;
    property <length> sheet-width:
        root.look == Look.list ? root.list-width
        : root.cards ? max(500px, root.list-width)
        : root.compact-width;
    property <length> head-room: root.cards ? 80px : 60px;
    property <length> body-room:
        root.cards ? root.cards-room
        : root.list-room;
    property <length> sheet-height: root.strip-room + (root.look == Look.compact
        ? root.compact-height
        : root.head-room + 1px + root.body-room + 1px + root.foot-room);

    out property <length> wanted-width: root.sheet-width + 2 * root.halo;
    out property <length> wanted-height: root.sheet-height + 2 * root.halo;
    // The side the icons are drawn at, for the resident to extract them at in screen pixels.
    out property <float> drawn-icon-side:
        root.look == Look.list ? 24 : 32;

    function toggle-private() {
        root.pinned-private = !root.pinned-private;
        root.private-on = root.pinned-private;
    }
    function step-chosen(by: int) {
        if (root.count == 0) {
            return;
        }
        root.chosen-at = root.chosen-at < 0
            ? (by > 0 ? 0 : root.count - 1)
            : Math.mod(root.chosen-at + by + root.count * 4, root.count);
    }

    keys := FocusScope {
        // Shift is held, not toggled: the mask lights while it is down.
        key-pressed(event) => {
            root.private-on = event.modifiers.shift || root.pinned-private;
            if (event.text == Key.Escape) {
                if (root.more-open) {
                    root.more-open = false;
                    return accept;
                }
                root.dismissed();
                return accept;
            }
            if (event.text == Key.Return && root.chosen-at >= 0) {
                root.open(root.chosen-at, root.private-on);
                return accept;
            }
            // The icons of the compact look lie in a row, so the arrows across walk them there;
            // everywhere else they walk the reaches, as they always did.
            if (root.look == Look.compact && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                root.step-chosen(event.text == Key.RightArrow ? 1 : -1);
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.step-chosen((event.text == Key.DownArrow ? 1 : -1)
                    * (root.cards ? 3 : 1));
                return accept;
            }
            // Every reach, not only the ones the track draws: the keyboard reaches those behind
            // the opener without having to open it.
            if (event.text == Key.LeftArrow) {
                root.reach-index = root.step-reach(-1);
                root.more-open = false;
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.Tab) {
                root.reach-index = root.step-reach(1);
                root.more-open = false;
                return accept;
            }
            if (event.text == "c" && (root.on-mac ? event.modifiers.meta : event.modifiers.control)) {
                root.copy();
                return accept;
            }
            if (event.text == "p" && (root.on-mac ? event.modifiers.meta : event.modifiers.control)) {
                root.toggle-private();
                return accept;
            }
            // The digit is worked out in Rust: with Shift held the layout hands
            // over "!" or "@" instead of "1", so comparing characters here made
            // Shift-to-open-privately break the very key it modifies.
            if (root.typed(event.text, root.private-on)) {
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            root.private-on = event.modifiers.shift || root.pinned-private;
            return reject;
        }

        if root.more-open: TouchArea {
            // Anywhere else puts it away, the way a menu does.
            clicked => { root.more-open = false; }
        }

        // The shadow is stacked, not blurred: six sheets fading outwards is what the
        // software renderer can draw, and it reads as one soft shadow.
        if root.halo > 0px: Rectangle {
            for step in [1, 2, 3, 4, 5, 6]: Rectangle {
                x: root.halo - step * 3px;
                y: root.halo - step * 2px + step * 1.5px;
                width: root.sheet-width + step * 6px;
                height: root.sheet-height + step * 6px;
                border-radius: 14px + step * 3px;
                background: Palette.shade;
                opacity: 0.05;
            }
        }

        sheet := Rectangle {
            x: root.halo;
            y: root.halo;
            width: root.sheet-width;
            height: root.sheet-height;
            border-radius: Palette.clear ? Palette.glass-corner : (root.look == Look.list ? 10px : 14px);
            background: Palette.clear ? Palette.veil : Palette.pane;
            border-width: Palette.clear && !root.private-on ? 0px : 1px;
            border-color: root.private-on ? Palette.secret : Palette.glow;

            if !Palette.clear: Rectangle {
                border-radius: parent.border-radius;
                background: Palette.glint;
            }

            Rectangle {
                x: parent.width * 0.15;
                y: 1px;
                width: parent.width * 0.7;
                height: 1px;
                background: @linear-gradient(90deg, transparent 0%, Palette.rim 50%, transparent 100%);
            }

            if root.update-shown: UpdateStrip {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                line: root.update-line;
                detail: root.update-detail;
                button: root.update-button;
                later: root.update-later;
                far: root.update-far;
                busy: root.update-busy;
                asked => { root.update-asked(); }
                dismissed => { root.update-dismissed(); }
            }

            if root.look == Look.compact: CompactLook {
                y: root.strip-room;
                height: root.compact-height;
                rows: root.rows;
                private-on: root.private-on;
                chosen-at: root.chosen-at;
                hovered-at: root.hovered-at;
                host: root.host;
                trail: root.trail;
                motto: root.problem != "" ? root.problem : root.motto;
                private-line: root.private-line;
                private-label: root.private-label;
                copied: root.copied;
                copy-label: root.copy-label;
                remember-label: root.remember-short;
                reach-said: root.reach-said;
                reach-keeps: root.all-reaches[root.reach-index].keeps;
                open(i) => { root.open(i, root.private-on); }
                hovered(i) => { root.hovered-at = i; }
                toggle-private => { root.toggle-private(); }
                copy => { root.copy(); }
                turn-reach => { root.reach-index = root.step-reach(1); }
            }

            if root.look != Look.compact: VerticalLayout {
                y: root.strip-room;
                height: parent.height - root.strip-room;
                if root.cards: AskHead {
                    ask: root.private-on ? root.ask-private : root.ask;
                    host: root.host;
                    trail: root.trail;
                    line: root.problem != "" ? root.problem : root.source-line;
                    line-color: root.problem != "" ? root.line-color : Palette.dim;
                    private-on: root.private-on;
                    private-label: root.private-label;
                    copied: root.copied;
                    copy-label: root.copy-label;
                    toggle-private => { root.toggle-private(); }
                    copy => { root.copy(); }
                }
                if !root.cards: AddressHead {
                    host: root.host;
                    trail: root.trail;
                    line: root.line;
                    line-color: root.line-color;
                    private-on: root.private-on;
                    private-label: root.private-label;
                    copied: root.copied;
                    copy-label: root.copy-label;
                    toggle-private => { root.toggle-private(); }
                    copy => { root.copy(); }
                }
                Hair {}
                if root.cards: CardsLook {
                    height: root.cards-room;
                    room: root.cards-room;
                    empty: root.count > 0 && root.count < 3 ? 3 - root.count : 0;
                    add: root.add;
                    add-more: root.add-more;
                    adding => { root.add-browser(); }
                    rows: root.rows;
                    private-on: root.private-on;
                    chosen-at: root.chosen-at;
                    open(i) => { root.open(i, root.private-on); }
                    hovered(i) => { root.hovered-at = i; }
                }
                if root.look == Look.list: ListLook {
                    height: root.list-room;
                    room: root.list-room;
                    rows: root.rows;
                    private-on: root.private-on;
                    chosen-at: root.chosen-at;
                    open(i) => { root.open(i, root.private-on); }
                    hovered(i) => { root.hovered-at = i; }
                }
                Hair {}
                RememberFoot {
                    label: root.remember-label;
                    reaches: root.reaches;
                    has-more: root.reaches-more.length > 0;
                    more-said: root.more-said;
                    more-holds: root.more-holds;
                    more-open: root.more-open;
                    reach-index: root.reach-index;
                    picked(i) => {
                        root.reach-index = i;
                        root.more-open = false;
                    }
                    more => { root.more-open = !root.more-open; }
                }
            }
        }

        if root.more-open && root.look != Look.compact: ReachMenu {
            x: root.halo + root.sheet-width - 12px - self.width;
            y: root.halo + root.sheet-height - 12px - 32px - 6px - self.height;
            reaches: root.reaches-more;
            reach-index: root.reach-index;
            picked(i) => {
                root.reach-index = i;
                root.more-open = false;
            }
        }
    }
}

export component Notice inherits Window {
    in property <string> headline;
    in property <string> reason;
    in property <string> undo-label;
    in property <bool> undoable: true;
    in-out property <int> left: 6;
    callback undo();
    callback dismissed();

    title: "LinkUnbound";
    icon: @image-url("../../../app/src-tauri/icons/128x128.png");
    no-frame: true;
    background: transparent;
    out property <length> wanted-width: 356px;
    out property <length> wanted-height: 76px;
    width: root.wanted-width;
    height: root.wanted-height;
    in property <string> family;
    default-font-family: root.family;

    Rectangle {
        border-radius: 10px;
        background: Palette.ground;
        border-width: 1px;
        border-color: Palette.edge;

        VerticalLayout {
        HorizontalLayout {
            height: 76px;
            padding-left: 15px;
            padding-right: 12px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.headline;
                    font-size: 13px;
                    color: Palette.ink;
                    overflow: elide;
                }
                Text {
                    text: root.reason;
                    font-size: 11.5px;
                    color: Palette.dim;
                    overflow: elide;
                }
            }

            if root.undoable: Rectangle {
                width: 76px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: undo-touch.has-hover ? Palette.hover : Palette.chip;
                undo-touch := TouchArea {
                    clicked => { root.undo(); }
                }
                Text {
                    text: root.undo-label;
                    font-size: 12px;
                    font-weight: 700;
                    color: Palette.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            Rectangle {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: close-touch.has-hover ? Palette.hover : transparent;
                close-touch := TouchArea {
                    clicked => { root.dismissed(); }
                }
                Text {
                    text: root.left;
                    font-size: 12px;
                    color: Palette.dimmer;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
        }
    }
}
