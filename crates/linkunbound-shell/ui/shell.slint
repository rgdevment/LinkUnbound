struct Destination {
    key: string,
    name: string,
    profile: string,
    icon: image,
    can-private: bool,
}

struct Reach {
    label: string,
    keeps: bool,
    dead: bool,
    index: int,
}

export global Palette {
    in property <bool> light: false;

    out property <brush> ground: light ? #FFFFFF : #191A1F;
    out property <brush> ink: light ? #16181D : #F0F1F4;
    out property <brush> dim: light ? #676D7C : #8B92A1;
    out property <brush> dimmer: light ? #6B7280 : #8B92A1;
    out property <brush> line: light ? #00000014 : #ffffff14;
    out property <brush> hover: light ? #0000000b : #ffffff12;
    out property <brush> chip: light ? #0000000e : #ffffff10;
    out property <brush> key-bg: light ? #00000010 : #ffffff14;
    out property <brush> key-ink: light ? #6C7280 : #A2A9B8;
    out property <brush> accent: light ? #2F62D8 : #6E9BFF;
    // Literals here were picked for a dark ground and sat at 2.2:1 on a light
    // one, which is where the launch failures are printed.
    out property <brush> wrong: light ? #B3261E : #FF8A85;
    out property <brush> caution: light ? #8A5200 : #E9A05C;
    out property <brush> accent-soft: light ? #2F62D821 : #6E9BFF2b;
    out property <brush> neutral: light ? #00000017 : #ffffff1c;
    out property <brush> neutral-ink: light ? #3A3F4B : #D6DAE3;
    out property <brush> edge: light ? #0000001f : #ffffff1a;
}

component Row inherits Rectangle {
    in property <Destination> entry;
    in property <bool> private-wanted;
    in property <float> icon-side;
    callback chosen(bool);

    height: 42px;
    border-radius: 7px;
    background: touch.has-hover ? Palette.hover : transparent;
    opacity: root.private-wanted && !root.entry.can-private ? 0.45 : 1.0;

    touch := TouchArea {
        enabled: !(root.private-wanted && !root.entry.can-private);
        clicked => { root.chosen(root.private-wanted); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 11px;

        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Palette.key-bg;
            Text {
                text: root.entry.key;
                font-size: 12px;
                color: Palette.key-ink;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        Image {
            source: root.entry.icon;
            width: root.icon-side * 1px;
            height: root.icon-side * 1px;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            image-rendering: smooth;
        }

        Text {
            text: root.entry.name;
            font-size: 14.5px;
            color: Palette.ink;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.entry.profile != "": Rectangle {
            horizontal-stretch: 0;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Palette.chip;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.entry.profile;
                    font-size: 12px;
                    color: Palette.dim;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component Segment inherits Rectangle {
    in property <Reach> reach;
    in property <bool> active;
    in property <bool> last;
    callback picked();

    height: 22px;
    // A Rectangle contributes nothing to the layout around it unless it says what it wants, and
    // the row's width is the sum of what its segments ask for.
    preferred-width: body.preferred-width;
    opacity: root.reach.dead ? 0.4 : 1.0;

    body := HorizontalLayout {
        spacing: 7px;

        VerticalLayout {
            spacing: 2px;
            alignment: center;

            label := Text {
                text: root.reach.label;
                font-size: 11.5px;
                color: root.active
                    ? (root.reach.keeps ? Palette.accent : Palette.neutral-ink)
                    : (touch.has-hover ? Palette.neutral-ink : Palette.dim);
                font-weight: root.active ? 700 : 400;
                vertical-alignment: center;
            }

            // The mark sits under the word rather than around it, so a row of four reads as one
            // line of text with one of them chosen.
            Rectangle {
                height: 2px;
                border-radius: 1px;
                background: root.active
                    ? (root.reach.keeps ? Palette.accent : Palette.neutral-ink)
                    : transparent;
            }
        }

        if !root.last: Text {
            text: "·";
            font-size: 11.5px;
            color: Palette.dimmer;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.reach.dead;
        width: label.width;
        x: 0;
        clicked => { root.picked(); }
    }
}

component IconButton inherits Rectangle {
    in property <bool> lit;
    callback pressed();

    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: root.lit
        ? Palette.accent-soft
        : (touch.has-hover ? Palette.hover : transparent);

    touch := TouchArea {
        clicked => { root.pressed(); }
    }
}

export component Picker inherits Window {
    in property <float> icon-side: 24;
    in property <string> host;
    in property <string> trail;
    in property <string> source-line;
    in property <string> remember-label;
    in property <string> private-label;
    in property <[Destination]> rows;
    in property <[Reach]> reaches;
    in property <[Reach]> reaches-more;
    in property <[string]> reach-labels;
    in property <string> reach-more-label;
    in property <string> reaches-line;
    in property <string> problem;
    in property <bool> alarming: true;
    in-out property <int> reach-index: 0;
    in-out property <bool> private-on: false;
    in-out property <bool> more-open: false;

    // True while the chosen reach is one the row does not show, which is when the opener has to
    // say which one rather than «More»: otherwise the choice is made and nothing on screen says
    // what it was.
    out property <bool> more-holds: !root.in-the-row[root.reach-index];
    in property <[bool]> in-the-row;
    in-out property <bool> pinned-private: false;
    in-out property <bool> copied: false;

    callback open(int, bool);
    /// Returns whether the key was a destination. See `key-pressed`.
    callback typed(string, bool) -> bool;
    callback dismissed();
    callback copy();

    title: "LinkUnbound";
    no-frame: true;
    background: transparent;
    width: root.wanted-width;
    height: root.wanted-height;
    default-font-family: "Segoe UI";
    forward-focus: keys;

    // A fifth reach appears when the click came from a known app, and its label carries that
    // app's name — which no fixed width can be drawn for. The reaches ask for the room they
    // need; the floor is the width the rows were designed at and the ceiling keeps one long
    // name from stretching the window across the screen.
    out property <length> wanted-width: min(
        max(348px, ruler.preferred-width + 30px + (root.reaches.length - 1) * 8px),
        560px);
    // Repeated elements reach the layout only once they are drawn, so the row cannot be asked
    // how wide it wants to be before the window has a width. This measures the same words in one
    // go instead, and the spacing the row puts around each separator is added on.
    ruler := Text {
        text: root.reaches-line;
        font-size: 11.5px;
        visible: false;
    }

    out property <length> wanted-height:
        66px + 1px
        + (root.rows.length * 42px) + 16px
        + 1px + 38px + 22px + 12px
        + (root.problem == "" ? 0px : 36px);

    keys := FocusScope {
        // Shift is held, not toggled: the icon lights while it is down.
        key-pressed(event) => {
            root.private-on = event.modifiers.shift || root.pinned-private;
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            // Reach, copy and private are the rest of what this window does, and
            // a TouchArea answers to nothing but a pointer: without these, a
            // keyboard could open a link but never remember one.
            // Every reach, not only the two the row draws: the keyboard reaches the ones behind
            // the opener without having to open it.
            if (event.text == Key.LeftArrow) {
                root.reach-index = max(0, root.reach-index - 1);
                root.more-open = false;
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.Tab) {
                root.reach-index = min(root.reach-labels.length - 1, root.reach-index + 1);
                root.more-open = false;
                return accept;
            }
            if (event.text == "c" && event.modifiers.control) {
                root.copy();
                return accept;
            }
            if (event.text == "p" && event.modifiers.control) {
                root.pinned-private = !root.pinned-private;
                root.private-on = root.pinned-private;
                return accept;
            }
            // The digit is worked out in Rust: with Shift held the layout hands
            // over "!" or "@" instead of "1", so comparing characters here made
            // Shift-to-open-privately break the very key it modifies.
            if (root.typed(event.text, root.private-on)) {
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            root.private-on = event.modifiers.shift || root.pinned-private;
            return reject;
        }

        if root.more-open: TouchArea {
            // Anywhere else puts it away, the way a menu does.
            clicked => { root.more-open = false; }
        }

        Rectangle {
            border-radius: 10px;
            background: Palette.ground;
            border-width: 1px;
            border-color: Palette.edge;

            VerticalLayout {
                Rectangle {
                    height: 66px;
                    HorizontalLayout {
                        padding-left: 15px;
                        padding-right: 11px;
                        spacing: 8px;
                        alignment: stretch;

                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: start;
                                Text {
                                    text: root.host;
                                    font-size: 14.5px;
                                    font-weight: 700;
                                    color: Palette.ink;
                                }
                                Text {
                                    text: root.trail;
                                    font-size: 14.5px;
                                    color: Palette.dimmer;
                                    overflow: elide;
                                }
                            }
                            if root.source-line != "": Text {
                                text: root.source-line;
                                font-size: 12px;
                                color: Palette.dim;
                            }
                        }

                        copy-button := IconButton {
                            y: (parent.height - self.height) / 2;
                            lit: root.copied;
                            pressed => { root.copy(); }
                            // Drawn: these glyphs are not in every system font.
                            Path {
                                x: 8px;
                                y: 8px;
                                width: 14px;
                                height: 14px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: root.copied ? Palette.accent : Palette.dim;
                                stroke-width: 1.9px;
                                commands: root.copied
                                    ? "M 5 13 L 10 18 L 19 6"
                                    : "M 9 9 L 19 9 L 19 21 L 9 21 Z M 5 15 L 5 5 L 15 5";
                            }
                        }

                        mask-button := IconButton {
                            y: (parent.height - self.height) / 2;
                            lit: root.private-on;
                            pressed => { root.pinned-private = !root.pinned-private; root.private-on = root.pinned-private; }
                            // Composed: Slint does not resolve elliptical arcs.
                            Rectangle {
                                x: 7px;
                                y: 13px;
                                width: 16px;
                                height: 2px;
                                border-radius: 1px;
                                background: root.private-on ? Palette.accent : Palette.dim;
                            }
                            Rectangle {
                                x: 8px;
                                y: 15px;
                                width: 7px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.private-on ? Palette.accent : Palette.dim;
                            }
                            Rectangle {
                                x: 15px;
                                y: 15px;
                                width: 7px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.private-on ? Palette.accent : Palette.dim;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.line; }

                VerticalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    for item[i] in root.rows: Row {
                        entry: item;
                        icon-side: root.icon-side;
                        private-wanted: root.private-on;
                        chosen(private) => { root.open(i, private); }
                    }
                }

                if root.problem != "": Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        Text {
                            text: root.problem;
                            font-size: 11.5px;
                            color: root.alarming ? Palette.wrong : Palette.caution;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.line; }

                Rectangle {
                    height: 38px;
                    HorizontalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        alignment: space-between;
                        Text {
                            text: root.remember-label;
                            font-size: 12.5px;
                            color: Palette.dimmer;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            Rectangle {
                                width: 24px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: root.private-on ? Palette.accent-soft : Palette.key-bg;
                                Text {
                                    text: "⇧";
                                    font-size: 13px;
                                    color: root.private-on ? Palette.accent : Palette.key-ink;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                            Text {
                                text: root.private-label;
                                font-size: 12.5px;
                                color: root.private-on ? Palette.accent : Palette.dimmer;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                scopes := HorizontalLayout {
                    padding-left: 15px;
                    padding-right: 15px;
                    padding-bottom: 12px;
                    spacing: 7px;
                    alignment: end;

                    for item in root.reaches: Segment {
                        reach: item;
                        active: item.index == root.reach-index;
                        last: false;
                        picked => {
                            root.reach-index = item.index;
                            root.more-open = false;
                        }
                    }

                    more := Rectangle {
                        height: 22px;
                        preferred-width: opener.preferred-width;

                        opener := HorizontalLayout {
                            spacing: 4px;
                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                said := Text {
                                    text: root.more-holds ? root.reach-labels[root.reach-index]
                                                          : root.reach-more-label;
                                    font-size: 11.5px;
                                    max-width: 150px;
                                    overflow: elide;
                                    color: root.more-holds
                                        ? Palette.accent
                                        : (more-touch.has-hover ? Palette.neutral-ink : Palette.dim);
                                    font-weight: root.more-holds ? 700 : 400;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 2px;
                                    border-radius: 1px;
                                    background: root.more-holds ? Palette.accent : transparent;
                                }
                            }
                            Text {
                                text: root.more-open ? "▴" : "▾";
                                font-size: 9px;
                                color: Palette.dimmer;
                                vertical-alignment: center;
                            }
                        }

                        more-touch := TouchArea {
                            clicked => { root.more-open = !root.more-open; }
                        }
                    }
                }
            }
        }
    }

        // Drawn over the rows rather than below the row that opens it: the reaches sit at the
        // bottom edge, and a list growing downwards would fall outside the window.
        if root.more-open: Rectangle {
            // Hangs from the opener, which sits at the right edge with the row.
            x: root.width - 15px - self.width;
            y: root.height - 12px - 22px - self.height - 6px;
            width: 190px;
            height: shelf.preferred-height;
            border-radius: 8px;
            background: Palette.ground;
            border-width: 1px;
            border-color: Palette.edge;

            TouchArea {}

            shelf := VerticalLayout {
                padding: 4px;
                for item in root.reaches-more: Rectangle {
                    height: 26px;
                    border-radius: 5px;
                    opacity: item.dead ? 0.4 : 1.0;
                    background: item.index == root.reach-index
                        ? Palette.accent-soft
                        : (option.has-hover ? Palette.hover : transparent);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: item.label;
                            font-size: 11.5px;
                            color: item.index == root.reach-index ? Palette.accent : Palette.dim;
                            font-weight: item.index == root.reach-index ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    option := TouchArea {
                        enabled: !item.dead;
                        clicked => {
                            root.reach-index = item.index;
                            root.more-open = false;
                        }
                    }
                }
            }
        }
}

export component Notice inherits Window {
    in property <string> headline;
    in property <string> reason;
    in property <string> undo-label;
    in-out property <int> left: 6;

    callback undo();
    callback dismissed();

    title: "LinkUnbound";
    no-frame: true;
    background: transparent;
    width: 356px;
    height: 76px;
    default-font-family: "Segoe UI";

    Rectangle {
        border-radius: 10px;
        background: Palette.ground;
        border-width: 1px;
        border-color: Palette.edge;

        HorizontalLayout {
            padding-left: 15px;
            padding-right: 12px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.headline;
                    font-size: 13px;
                    color: Palette.ink;
                    overflow: elide;
                }
                Text {
                    text: root.reason;
                    font-size: 11.5px;
                    color: Palette.dim;
                    overflow: elide;
                }
            }

            Rectangle {
                width: 76px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: undo-touch.has-hover ? Palette.hover : Palette.chip;
                undo-touch := TouchArea {
                    clicked => { root.undo(); }
                }
                Text {
                    text: root.undo-label;
                    font-size: 12px;
                    font-weight: 700;
                    color: Palette.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }

            Rectangle {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: close-touch.has-hover ? Palette.hover : transparent;
                close-touch := TouchArea {
                    clicked => { root.dismissed(); }
                }
                Text {
                    text: root.left;
                    font-size: 12px;
                    color: Palette.dimmer;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}
