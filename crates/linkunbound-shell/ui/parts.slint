export struct Destination {
    key: string,
    name: string,
    profile: string,
    icon: image,
    can-private: bool,
}

export struct Reach {
    label: string,
    full: string,
    keeps: bool,
    dead: bool,
    index: int,
}

export global Palette {
    in property <bool> light: false;
    // Over Acrylic the system paints the material, the corners and the edge of the picker.
    in property <bool> clear: false;
    // Laid over Acrylic: the blur is the system's, the tone and the lit edge stay the picker's.
    out property <brush> veil: light
        ? @linear-gradient(180deg, #FFFFFFC4 0%, #F3F5F9CC 100%)
        : @linear-gradient(180deg, #282B36C4 0%, #1A1C23CC 100%);
    out property <color> rim: light ? #FFFFFFE6 : #FFFFFF2E;

    out property <brush> ground: light ? #FFFFFF : #191A1F;
    // Header and footer sit a shade apart from the list, which is what tells the zones apart.
    out property <brush> band: light ? #F8F9FB : #1C1D23;
    out property <brush> ink: light ? #16181D : #F0F1F4;
    out property <brush> dim: light ? #555B6A : #AAB1C0;
    out property <brush> dimmer: light ? #5F6575 : #9CA3B3;
    out property <brush> line: light ? #00000014 : #ffffff14;
    out property <brush> hover: light ? #0000000b : #ffffff12;
    out property <brush> chip: light ? #0000000e : #ffffff10;
    out property <brush> key-bg: light ? #00000010 : #ffffff14;
    out property <brush> key-ink: light ? #5F6575 : #B3BAC9;
    out property <brush> accent: light ? #2F62D8 : #6E9BFF;
    // Literals here were picked for a dark ground and sat at 2.2:1 on a light
    // one, which is where the launch failures are printed.
    out property <brush> wrong: light ? #B3261E : #FF8A85;
    out property <brush> caution: light ? #8A5200 : #E9A05C;
    out property <brush> accent-soft: light ? #2F62D821 : #6E9BFF2b;
    out property <brush> neutral: light ? #00000017 : #ffffff1c;
    out property <brush> neutral-ink: light ? #3A3F4B : #D6DAE3;
    out property <brush> edge: light ? #0000001f : #ffffff1a;
    // The modern surface: one sheet, separated by fill rather than by lines.
    out property <brush> surface: light ? #FFFFFF : #1E2027;
    out property <brush> sheet-band: light ? #F8F9FB : #212329;
    out property <brush> fill: light ? #0000000c : #ffffff0e;
    out property <brush> fill-hover: light ? #00000014 : #ffffff1a;
    out property <brush> faint: light ? #6B7280 : #8791A4;
    out property <brush> glow: light ? #0000000f : #ffffff12;
    out property <brush> shade: light ? #14192d : #000000;
    out property <brush> accent-ink: light ? #FFFFFF : #12141B;
    // The mascot's blue marks what is chosen; violet is the private window.
    out property <brush> brand: light ? #3E6BE0 : #7FA2FF;
    out property <brush> brand-soft: light ? #3E6BE01f : #7FA2FF24;
    out property <brush> secret: light ? #7A4FE0 : #B79BFF;
    out property <brush> secret-soft: light ? #7A4FE024 : #B79BFF29;
    out property <brush> hair: light ? #00000012 : #ffffff17;
    out property <brush> track: light ? #0000000d : #00000033;
    out property <brush> thumb: light ? #FFFFFF : #ffffff1c;
}

export enum Look { list, tiles, compact, bear }

export // Two sheets, one over the other: rectangles, which the software renderer draws with edges,
// where a stroked path came out soft. Lit once the address was really copied.
component CopyMark inherits Rectangle {
    in property <bool> done;
    in property <string> label;
    callback pressed();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.pressed(); }
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.hover : transparent;
    property <brush> line: root.done ? Palette.accent : (touch.has-hover ? Palette.dim : Palette.faint);

    Rectangle {
        x: 7px;
        y: 7px;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: root.line;
    }
    Rectangle {
        x: 11px;
        y: 11px;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: root.line;
        background: Palette.clear ? transparent : Palette.surface;
    }
    touch := TouchArea {
        clicked => { root.pressed(); }
    }
}

export // The update, when one is owed: what it is, what pressing does, and how far along it is. The
// same strip sits atop both looks of the picker.
component UpdateStrip inherits Rectangle {
    in property <string> line;
    in property <string> detail;
    in property <string> button;
    in property <string> later;
    in property <int> far;
    in property <bool> busy;
    callback asked();
    callback dismissed();

    height: 36px;
    border-radius: 10px;
    background: Palette.accent-soft;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.line;
                font-size: 12.5px;
                color: Palette.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-size: 11.5px;
                color: Palette.dim;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.far > 0: Rectangle {
                height: 3px;
                border-radius: 2px;
                background: Palette.neutral;
                Rectangle {
                    x: 0;
                    width: parent.width * root.far / 100;
                    height: 100%;
                    border-radius: 2px;
                    background: Palette.accent;
                }
            }
        }

        if root.button != "": Rectangle {
            accessible-role: AccessibleRole.button;
            accessible-label: root.button;
            accessible-action-default => { root.asked(); }
            horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            height: 26px;
            width: take-words.preferred-width + 24px;
            border-radius: 13px;
            background: Palette.accent;
            opacity: take-touch.has-hover ? 0.9 : 1.0;
            take-words := Text {
                text: root.button;
                font-size: 12.5px;
                font-weight: 600;
                color: Palette.accent-ink;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            take-touch := TouchArea {
                clicked => { root.asked(); }
            }
        }

        if !root.busy: Rectangle {
            accessible-role: AccessibleRole.button;
            accessible-label: root.later;
            accessible-action-default => { root.dismissed(); }
            horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: later-touch.has-hover ? Palette.fill-hover : transparent;
            Path {
                x: 7px;
                y: 7px;
                width: 8px;
                height: 8px;
                viewbox-width: 8;
                viewbox-height: 8;
                stroke: Palette.faint;
                stroke-width: 1.5px;
                commands: "M 1 1 L 7 7 M 7 1 L 1 7";
            }
            later-touch := TouchArea {
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component Hair inherits Rectangle {
    height: 1px;
    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        height: 1px;
        background: @linear-gradient(90deg, transparent 0%, Palette.hair 12%, Palette.hair 88%, transparent 100%);
    }
}

// A key on a keyboard: lit from above, pressed into the sheet.
export component KeyCap inherits Rectangle {
    in property <string> key;
    in property <bool> lit;
    width: max(20px, words.preferred-width + 10px);
    height: 20px;
    border-radius: 5px;
    visible: root.key != "";
    background: root.lit ? Palette.brand : Palette.key-bg;
    Rectangle {
        x: 2px;
        y: 1px;
        width: parent.width - 4px;
        height: 1px;
        background: root.lit ? transparent : Palette.rim;
        opacity: 0.6;
    }
    words := Text {
        text: root.key;
        font-size: 11.5px;
        font-weight: 600;
        color: root.lit ? #FFFFFF : Palette.key-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// The browser's icon, with a violet dot while it is about to open privately.
export component Badge inherits Rectangle {
    in property <image> icon;
    in property <bool> secret;
    Image {
        source: root.icon;
        width: 100%;
        height: 100%;
        image-fit: contain;
        image-rendering: smooth;
    }
    if root.secret: Rectangle {
        x: parent.width - 9px;
        y: parent.height - 9px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Palette.secret;
        border-width: 2px;
        border-color: Palette.light ? #FFFFFF : #1E2027;
    }
}

// A mask: open privately. Lit while Shift is down or after a press, which pins it.
export component MaskButton inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback pressed();

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.pressed(); }
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: root.on ? Palette.secret-soft : (touch.has-hover ? Palette.hover : transparent);
    Path {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M2 6.5 C4 4.9 12 4.9 14 6.5 C13.8 9.7 12.2 11 10.5 11 C9.2 11 8.7 9.7 8 9.7 C7.3 9.7 6.8 11 5.5 11 C3.8 11 2.2 9.7 2 6.5 Z";
        stroke: root.on ? Palette.secret : (touch.has-hover ? Palette.dim : Palette.faint);
        stroke-width: 1.3px;
    }
    Path {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M4.5 7.6 a0.9 0.9 0 1 0 1.8 0 a0.9 0.9 0 1 0 -1.8 0 Z M9.7 7.6 a0.9 0.9 0 1 0 1.8 0 a0.9 0.9 0 1 0 -1.8 0 Z";
        fill: root.on ? Palette.secret : (touch.has-hover ? Palette.dim : Palette.faint);
    }
    touch := TouchArea {
        clicked => { root.pressed(); }
    }
}

export component Tools inherits HorizontalLayout {
    in property <bool> private-on;
    in property <string> private-label;
    in property <bool> copied;
    in property <string> copy-label;
    callback toggle-private();
    callback copy();
    spacing: 2px;
    MaskButton {
        on: root.private-on;
        label: root.private-label;
        pressed => { root.toggle-private(); }
    }
    CopyMark {
        label: root.copy-label;
        done: root.copied;
        pressed => { root.copy(); }
    }
}

// The address and, under it, where it came from, what is wrong, or that it opens privately.
export component AddressHead inherits Rectangle {
    in property <string> host;
    in property <string> trail;
    in property <string> line;
    in property <brush> line-color;
    in property <bool> private-on;
    in property <string> private-label;
    in property <bool> copied;
    in property <string> copy-label;
    callback toggle-private();
    callback copy();
    height: 60px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: start;
                Text {
                    text: root.host;
                    font-size: 15px;
                    font-weight: 600;
                    color: Palette.ink;
                }
                Text {
                    text: root.trail;
                    font-size: 15px;
                    color: Palette.dimmer;
                    overflow: elide;
                }
            }
            if root.line != "": Text {
                text: root.line;
                font-size: 12px;
                color: root.line-color;
                font-weight: root.private-on ? 600 : 400;
                overflow: elide;
            }
        }
        Tools {
            y: (parent.height - 28px) / 2;
            height: 28px;
            private-on: root.private-on;
            private-label: root.private-label;
            copied: root.copied;
            copy-label: root.copy-label;
            toggle-private => { root.toggle-private(); }
            copy => { root.copy(); }
        }
    }
}

// The bear's header: it asks, and the address answers under the question.
export component AskHead inherits Rectangle {
    in property <string> ask;
    in property <string> host;
    in property <string> trail;
    in property <string> line;
    in property <brush> line-color;
    in property <bool> private-on;
    in property <string> private-label;
    in property <bool> copied;
    in property <string> copy-label;
    callback toggle-private();
    callback copy();
    height: 104px;

    VerticalLayout {
        padding-top: 38px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 3px;
        alignment: start;
        Text {
            text: root.ask;
            font-size: 17px;
            font-weight: 700;
            color: root.private-on ? Palette.secret : Palette.ink;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: root.host;
                font-size: 13px;
                font-weight: 600;
                color: Palette.ink;
            }
            Text {
                text: root.trail;
                font-size: 13px;
                color: Palette.dimmer;
                max-width: root.width - 200px;
                overflow: elide;
            }
        }
        if root.line != "": Text {
            text: root.line;
            font-size: 12px;
            color: root.line-color;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    Tools {
        x: root.width - 8px - self.width;
        y: 8px;
        height: 28px;
        private-on: root.private-on;
        private-label: root.private-label;
        copied: root.copied;
        copy-label: root.copy-label;
        toggle-private => { root.toggle-private(); }
        copy => { root.copy(); }
    }
}

// «Recordar»: the reaches in a segmented track, the rest behind «Más».
export component RememberFoot inherits Rectangle {
    in property <string> label;
    in property <[Reach]> reaches;
    in property <bool> has-more;
    in property <string> more-said;
    in property <bool> more-holds;
    in property <bool> more-open;
    in property <int> reach-index;
    callback picked(int);
    callback more();
    height: 74px;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 7px;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: Palette.faint;
            x: 4px;
        }
        Rectangle {
            height: 32px;
            border-radius: 7px;
            background: Palette.track;
            HorizontalLayout {
                padding: 3px;
                spacing: 2px;
                for item in root.reaches: Rectangle {
                    property <bool> on: item.index == root.reach-index;
                    horizontal-stretch: 1;
                    border-radius: 5px;
                    opacity: item.dead ? 0.4 : 1.0;
                    background: self.on ? Palette.thumb : transparent;
                    drop-shadow-blur: self.on ? 2px : 0px;
                    drop-shadow-color: #0000002e;
                    drop-shadow-offset-y: 1px;
                    Text {
                        text: item.label;
                        font-size: 12.5px;
                        font-weight: parent.on ? 600 : 400;
                        color: parent.on ? (item.keeps ? Palette.brand : Palette.ink) : (seg.has-hover ? Palette.ink : Palette.dim);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        width: parent.width - 8px;
                    }
                    seg := TouchArea {
                        enabled: !item.dead;
                        clicked => { root.picked(item.index); }
                    }
                }
                if root.has-more: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 5px;
                    background: root.more-holds ? Palette.thumb : transparent;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text {
                            text: root.more-said;
                            font-size: 12.5px;
                            font-weight: root.more-holds ? 600 : 400;
                            color: root.more-holds ? Palette.brand : (opener.has-hover ? Palette.ink : Palette.dim);
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 120px;
                        }
                        Rectangle {
                            width: 8px;
                            Path {
                                y: (parent.height - 5px) / 2;
                                width: 8px;
                                height: 5px;
                                viewbox-width: 8;
                                viewbox-height: 5;
                                stroke: root.more-holds ? Palette.brand : Palette.faint;
                                stroke-width: 1.5px;
                                commands: root.more-open ? "M 1 4 L 4 1 L 7 4" : "M 1 1 L 4 4 L 7 1";
                            }
                        }
                    }
                    opener := TouchArea {
                        clicked => { root.more(); }
                    }
                }
            }
        }
    }
}

// The reaches the track has no room for, hanging upwards from it.
export component ReachMenu inherits Rectangle {
    in property <[Reach]> reaches;
    in property <int> reach-index;
    callback picked(int);
    width: 210px;
    height: shelf.preferred-height;
    border-radius: 8px;
    background: Palette.clear ? Palette.ground : Palette.surface;
    border-width: 1px;
    border-color: Palette.edge;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    TouchArea {}
    shelf := VerticalLayout {
        padding: 4px;
        for item in root.reaches: Rectangle {
            height: 28px;
            border-radius: 5px;
            opacity: item.dead ? 0.4 : 1.0;
            background: item.index == root.reach-index ? Palette.brand-soft : (option.has-hover ? Palette.hover : transparent);
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: item.label;
                    font-size: 12.5px;
                    color: item.index == root.reach-index ? Palette.brand : Palette.ink;
                    font-weight: item.index == root.reach-index ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            option := TouchArea {
                enabled: !item.dead;
                clicked => { root.picked(item.index); }
            }
        }
    }
}
