{
  "globs": ["**/*.md", "!node_modules", "!target", "!app/node_modules", "!THIRD-PARTY-BUNDLED.md"],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD007": { "indent": 4 },
    "MD010": { "code_blocks": false },
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" },
    "MD029": { "style": "ordered" },
    "MD046": { "style": "fenced" },
    "MD060": false
  }
}
